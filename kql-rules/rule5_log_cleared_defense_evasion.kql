// Rule 5: Windows Security Event Log Cleared
// MITRE ATT&CK: Defense Evasion (TA0005) - Indicator Removal on Host: Clear Windows Event Logs (T1070.001)
// Severity: High
// Schedule: Every 5 minutes looking across 1 hour

SecurityEvent
| where TimeGenerated >= ago(1h)
| where EventID == 1102
| project TimeGenerated, Computer, Account, Activity
| extend HostName = tostring(split(Computer, ".")[0])
